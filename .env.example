# car-auction-app-backend API origin (no trailing slash). Its CORS_ORIGINS must include this site.
NEXT_PUBLIC_API_URL=https://lotline-api.57-129-139-194.sslip.io

# Sign-in on the booking flow. Email codes work with no extra setup; the buttons below
# only show when their ID is set.
# Google web OAuth client ID. Add it to the API's GOOGLE_CLIENT_IDS and this site's origin
# to the client's Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=
# Apple Services ID. Add it to the API's APPLE_AUDIENCES and register this site's origin
# as a return URL for the Services ID.
NEXT_PUBLIC_APPLE_SERVICES_ID=

# Where "Get help" and "Add more time" go: a mailto: or wa.me link. Defaults to the contact email.
NEXT_PUBLIC_SUPPORT_URL=
